{
  "name": "superdesk/web-publisher",
  "description": "Superdesk Web Publisher - the next generation publishing platform for journalists and newsrooms.",
  "type": "project",
  "keywords": [
    "superdesk",
    "webpublisher",
    "publisher",
    "content",
    "bridge",
    "tool",
    "publishing",
    "journalism",
    "newsroom",
    "news",
    "media"
  ],
  "authors": [
    {
      "name": "Paweł Mikołajczuk",
      "email": "mikolajczuk.private@gmail.com"
    },
    {
      "name": "Rafał Muszyński",
      "email": "rafal.muszynski@sourcefabric.org"
    },
    {
      "name": "Mark Lewis",
      "email": "mark.lewis@sourcefabric.org"
    },
    {
      "name": "Mischa Gorinskat",
      "email": "mischa.gorinskat@sourcefabric.org"
    }
  ],
  "license": "AGPL-3.0",
  "autoload": {
    "psr-4": {
      "SWP\\Bundle\\": "src/SWP/Bundle/",
      "SWP\\Component\\": "src/SWP/Component/",
      "SWP\\Bridge\\": "src/SWP/Bridge/",
      "SWP\\Behat\\": "src/SWP/Behat/"
    },
    "exclude-from-classmap": [
      "**/Tests/",
      "**/spec/"
    ],
    "classmap": [
      "src/Kernel.php"
    ]
  },
  "require": {
    "php": ">=8.3",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-gd": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-zip": "*",
    "behat/transliterator": "^1.3",
    "doctrine/dbal": "^3.8",
    "doctrine/doctrine-bundle": "^2.12",
    "doctrine/doctrine-migrations-bundle": "^3.3",
    "doctrine/inflector": "^2.0",
    "doctrine/migrations": "^3.7",
    "doctrine/orm": "^2.20",
    "doctrine/phpcr-bundle": "^3.0",
    "doctrine/phpcr-odm": "^2.0",
    "friendsofsymfony/elastica-bundle": "^6.3",
    "friendsofsymfony/http-cache": "^3.0",
    "friendsofsymfony/http-cache-bundle": "^3.0",
    "friendsofsymfony/rest-bundle": "^3.8",
    "gedmo/doctrine-extensions": "^3.15",
    "geoip2/geoip2": "^2.13",
    "gesdinet/jwt-refresh-token-bundle": "^1.3",
    "graylog2/gelf-php": "^1.7",
    "guzzlehttp/guzzle": "^7.8",
    "http-interop/http-factory-guzzle": "^1.2",
    "jackalope/jackalope-doctrine-dbal": "^2.0",
    "jeremykendall/php-domain-parser": "^6.3",
    "jms/serializer-bundle": "^5.4",
    "jms/translation-bundle": "^2.4",
    "justinrainbow/json-schema": "^5.2",
    "knplabs/knp-menu-bundle": "^3.3",
    "knplabs/knp-paginator-bundle": "^6.3",
    "knplabs/knp-time-bundle": "^2.2",
    "knpuniversity/oauth2-client-bundle": "^2.18",
    "laminas/laminas-stdlib": "^3.19",
    "league/flysystem-aws-s3-v3": "^3.0",
    "league/flysystem-google-cloud-storage": "^3.0",
    "lexik/jwt-authentication-bundle": "^2.20",
    "nelmio/cors-bundle": "^2.4",
    "nyholm/psr7": "^1.8",
    "oneup/flysystem-bundle": "^4.12",
    "php-http/guzzle7-adapter": "^1.0",
    "phpcr/phpcr-utils": "^2.0",
    "ramsey/uuid": "^4.7",
    "sentry/sentry-symfony": "^5.0",
    "stof/doctrine-extensions-bundle": "^1.10",
    "sylius/theme-bundle": "^2.3",
    "symfony-cmf/routing": "^3.0",
    "symfony-cmf/routing-bundle": "^3.0",
    "symfony/cache": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "symfony/dependency-injection": "7.4.*",
    "symfony/doctrine-bridge": "7.4.*",
    "symfony/dom-crawler": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/flex": "^2",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-kernel": "7.4.*",
    "symfony/lock": "7.4.*",
    "symfony/mailer": "7.4.*",
    "symfony/mercure-bundle": "^0.3",
    "symfony/messenger": "7.4.*",
    "symfony/mime": "7.4.*",
    "symfony/monolog-bundle": "^3.10",
    "symfony/psr-http-message-bridge": "^7.4",
    "symfony/routing": "7.4.*",
    "symfony/serializer": "7.4.*",
    "symfony/translation": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/web-link": "7.4.*",
    "symfony/yaml": "7.4.*",
    "symfonycasts/reset-password-bundle": "^1.20",
    "symfonycasts/verify-email-bundle": "^1.17",
    "twig/extra-bundle": "^3.8",
    "twig/intl-extra": "^3.8",
    "twig/string-extra": "^3.8",
    "twig/twig": "^3.8",
    "voku/stringy": "^6.5",
    "willdurand/hateoas-bundle": "^2.6"
  },
  "require-dev": {
    "behat/behat": "^3.14",
    "blackfire/php-sdk": "^1.22",
    "dg/bypass-finals": "^1.6",
    "dms/phpunit-arraysubset-asserts": "^0.5",
    "doctrine/data-fixtures": "^1.7",
    "doctrine/doctrine-fixtures-bundle": "^3.5",
    "friends-of-behat/mink-browserkit-driver": "^1.6",
    "friends-of-behat/service-container-extension": "^1.1",
    "friends-of-behat/symfony-extension": "^2.4",
    "liip/functional-test-bundle": "^4.11",
    "liip/rmt": "^1.7",
    "liip/test-fixtures-bundle": "^2.7",
    "matthiasnoback/symfony-dependency-injection-test": "^5.1",
    "nelmio/alice": "^3.13",
    "phpspec/phpspec": "^7.5",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^9.6",
    "rdx/behat-variables": "^1.2",
    "rector/rector": "^1.2",
    "roave/security-advisories": "dev-latest",
    "symfony-cmf/testing": "^4.0",
    "symfony/browser-kit": "7.4.*",
    "symfony/debug-bundle": "7.4.*",
    "symfony/phpunit-bridge": "7.4.*",
    "symfony/web-profiler-bundle": "7.4.*",
    "theofidry/alice-data-fixtures": "^1.7"
  },
  "replace": {
    "sentry/sdk": "*",
    "swp/common": "self.version",
    "swp/multi-tenancy": "self.version",
    "swp/multi-tenancy-bundle": "self.version",
    "swp/analytics-bundle": "self.version",
    "swp/bridge-bundle": "self.version",
    "swp/bridge": "self.version",
    "swp/storage-bundle": "self.version",
    "swp/storage": "self.version",
    "swp/templates-system-bundle": "self.version",
    "swp/templates-system": "self.version",
    "swp/rule-bundle": "self.version",
    "swp/rule": "self.version",
    "swp/elastic-search-bundle": "self.version",
    "swp/output-channel-bundle": "self.version",
    "swp/output-channel": "self.version",
    "swp/paywall-bundle": "self.version",
    "swp/paywall": "self.version",
    "swp/menu-bundle": "self.version",
    "swp/webhook-bundle": "self.version",
    "swp/webhook": "self.version",
    "swp/user-bundle": "self.version",
    "swp/settings-bundle": "self.version",
    "swp/content-list-bundle": "self.version",
    "swp/content-list": "self.version",
    "swp/seo": "self.version",
    "swp/seo-bundle": "self.version",
    "swp/geo-ip-bundle": "self.version",
    "swp/geo-ip": "self.version",
    "swp/archiver": "self.version",
    "swp/redirect-route-bundle": "self.version"
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "config": {
    "bin-dir": "bin",
    "sort-packages": true,
    "platform": {
      "php": "8.3.0",
      "ext-gd": "8.3.0",
      "ext-sodium": "8.3.0",
      "ext-fileinfo": "8.3.0"
    },
    "allow-plugins": {
      "symfony/flex": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "branch-alias": {
      "dev-master": "2.2-dev"
    },
    "symfony": {
      "allow-contrib": true,
      "require": "7.4.*"
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    }
  }
}
